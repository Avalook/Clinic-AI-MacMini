# ClinicAI dashboard (Next.js 16 standalone) — multi-stage, non-root.
# NEXT_PUBLIC_* are PUBLIC anon-tier values, inlined into the client bundle at
# build time (passed as build args, NOT baked secrets). Reads Supabase directly.

# ---- deps ----
FROM node:22-alpine AS deps
WORKDIR /app
# playwright là devDependency (chỉ cho e2e) — build image KHÔNG cần tải browser.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package.json package-lock.json ./
RUN npm ci

# ---- builder ----
FROM node:22-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_TELEMETRY_DISABLED=1 \
    BUILD_STANDALONE=1
# Chặn ngay tại đây, đừng để ra tới trình duyệt.
#
# `NEXT_PUBLIC_SUPABASE_URL` bị nung vào bundle JS, và nó là địa chỉ TRÌNH DUYỆT
# gọi — không phải địa chỉ container gọi. Đưa nhầm một tên máy nội bộ Docker vào
# đây thì build vẫn xanh, container vẫn healthy, đăng nhập vẫn chạy (server
# action), chỉ có realtime, nút Thoát và đặt lại mật khẩu là chết — im lặng.
#
# Đã xảy ra hai lần: `host.docker.internal:54321` ở staging, rồi
# `clinicai_supabase_gateway:8000` trên VPS ngày 05/08/2026.
#
# Luật: tên máy phải có dấu chấm (tên miền hoặc IP), hoặc là localhost. Một tên
# máy trần như `clinicai_supabase_gateway` chỉ phân giải được trong mạng Docker.
RUN set -eu; \
    host=$(printf '%s' "${NEXT_PUBLIC_SUPABASE_URL:-}" | sed -E 's#^[a-z]+://##; s#[:/].*$##'); \
    if [ -z "$host" ]; then \
        echo "LỖI: NEXT_PUBLIC_SUPABASE_URL trống." >&2; exit 1; \
    fi; \
    case "$host" in \
        localhost|127.0.0.1|*.*) : ;; \
        *) echo "LỖI: NEXT_PUBLIC_SUPABASE_URL trỏ vào '$host' — tên máy nội bộ Docker," >&2; \
           echo "     trình duyệt không phân giải được. Đặt PUBLIC_SUPABASE_URL thành" >&2; \
           echo "     địa chỉ người dùng gõ trên thanh địa chỉ." >&2; exit 1 ;; \
    esac

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

# ---- runner: minimal standalone server, run as built-in node user (uid 1000) ----
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN apk add --no-cache curl

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

USER node
EXPOSE 3000

CMD ["node", "server.js"]
