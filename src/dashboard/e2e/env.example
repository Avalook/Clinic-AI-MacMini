# === E2E intake-day-simulation — biến môi trường ===
# Copy thành file riêng (vd e2e/.env.local — đã bị .gitignore) rồi `source` trước khi chạy,
# hoặc export trực tiếp trong shell. KHÔNG commit credential thật.

# URL app đang chạy (dev khuyến nghị). Nếu là prod (dr4women.vercel.app) sẽ tự bật chế độ
# chặn ghi trừ khi có E2E_ALLOW_PROD_WRITE=1.
E2E_BASE_URL=http://localhost:3000


# Tài khoản theo vai (chỉ cần những vai bạn muốn test; thiếu → phase tương ứng SKIP).
# - Phase A cần 1 tài khoản canWriteIntake: Lễ tân hoặc CSKH.
# - Check-in (Phase B) cần Lễ tân (RECEPTION) hoặc Quản lý.
# - Phase F (lab) cần Bác sĩ (đặt chỉ định) + Lab/Điều dưỡng (trả kết quả).
E2E_CSKH_EMAIL=
E2E_CSKH_PASSWORD=
E2E_RECEPTION_EMAIL=
E2E_RECEPTION_PASSWORD=
E2E_DOCTOR_EMAIL=
E2E_DOCTOR_PASSWORD=
E2E_LAB_EMAIL=
E2E_LAB_PASSWORD=

# An toàn ghi dữ liệu.
E2E_ALLOW_WRITE=0          # 1 = cho phép tạo dữ liệu test (prefix E2E_TEST_)
E2E_ALLOW_PROD_WRITE=0     # 1 = cho phép ghi ngay cả khi BASE_URL là production
E2E_CLEANUP=0              # 1 = huỷ (cancel) lịch test sau khi chạy (KHÔNG xoá cứng)

# Khác.
E2E_HEADLESS=1             # 0 = mở trình duyệt để xem bot thao tác
