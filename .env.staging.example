# ClinicAI STAGING env — copy to .env.staging and fill. NEVER commit the filled file.
# Staging runs SIDE-BY-SIDE with prod on the same VPS: different project name +
# different Caddy host ports + a SEPARATE self-hosted Supabase stack.
# Staging Supabase MUST use fake/anonymised data — never a copy of real patient PII.

# --- Environment identity ---
APP_ENV=staging
COMPOSE_PROJECT_NAME=clinicai_staging
IMAGE_TAG=staging
CLINIC_ENV_FILE=.env.staging
COMPOSE_PROFILES=

# --- Staging Supabase Self-host (Separate stack from prod) ---
# SUPABASE_PREFIX: Tên tiền tố container staging (BẮT BUỘC clinicai_stg, không được là clinicai)
SUPABASE_PREFIX=clinicai_stg
# SUPABASE_NETWORK: Mạng DB staging (BẮT BUỘC clinicai_stg_db_supabase, không được là clinicai_db_supabase)
SUPABASE_NETWORK=clinicai_stg_db_supabase
# SUPABASE_GATEWAY_HOST: Host gateway của staging
SUPABASE_GATEWAY_HOST=clinicai_stg_supabase_gateway
# AUTH_GUARD_HOST: Host guard chặn dò mật khẩu của staging
AUTH_GUARD_HOST=clinicai_stg_auth_guard
# Cổng DB và Gateway API trên localhost host máy chủ (khác prod: prod là 54322 và 54321)
SUPABASE_DB_PORT=54332
SUPABASE_API_PORT=54331

# Bí mật staging — PHẢI KHÁC PROD HOÀN TOÀN (dung-staging.sh sẽ từ chối nếu trùng)
SUPABASE_JWT_SECRET=<staging-jwt-secret-ngau-nhien-it-nhat-32-ky-tu-khac-prod>
SUPABASE_DB_PASSWORD=<staging-db-password-ngau-nhien-khac-prod>
BACKEND_API_KEY=<long-random-string-staging-khac-prod>

# Key mẫu anon/service_role được sinh từ SUPABASE_JWT_SECRET riêng của staging
SUPABASE_ANON_KEY=<staging-anon-key-sinh-tu-jwt-secret-staging>
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key-sinh-tu-jwt-secret-staging>

# Kết nối nội bộ Docker giữa App Staging và Supabase Staging
DATABASE_URL=postgresql+asyncpg://postgres:<staging-db-password>@clinicai_stg_db:5432/postgres
SUPABASE_URL=http://clinicai_stg_supabase_gateway:8000
CHECKPOINTER_BACKEND=postgres

# --- Ingress (Caddy Staging) — cổng riêng không đụng prod (prod nghe 80/443) ---
SITE_ADDRESS=:8080
CADDY_BIND_ADDRESS=0.0.0.0
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
# Ổ khoá HTTP Basic Auth bảo vệ staging ngoài Internet (Caddyfile.staging)
CADDY_FILE=./caddy/Caddyfile.staging
STAGING_AUTH_USER=team
# Sinh hash bằng lệnh: docker run --rm -it caddy:2-alpine caddy hash-password
# LƯU Ý: Mọi ký tự '$' trong hash PHẢI NHÂN ĐÔI thành '$$' để compose không coi là biến
STAGING_AUTH_HASH=$$2a$$14$$...

# --- Frontend Browser Access ---
# URL staging mà TRÌNH DUYỆT CỦA NGƯỜI DÙNG truy cập được (chạy phía client-side).
# KHÔNG mặc định 127.0.0.1 trừ khi người dùng mở SSH tunnel/port forwarding về máy mình.
# Nếu mở thẳng qua IP VPS hoặc domain: đặt http://<IP-VPS>:8080 hoặc https://staging.dr4women.io.vn.
NEXT_PUBLIC_SUPABASE_URL=http://<staging-accessible-host>:8080
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# --- Lưu trữ Media (TÁCH BIỆT KHỎI PROD) ---
# Thư mục bind media riêng cho staging, tránh ghi đè hoặc xoá nhầm ảnh/video thật của prod
MEDIA_DIR=./.media/staging
OPS_STATUS_DIR=./.ops-status/staging

# --- Nghiệp vụ (Khớp #175) ---
# Tạm thời thu tiền thuốc theo catalog không qua kho vật lý (0 = OFF, 1 = ON)
CLINICAI_DRUG_PAYMENT_REQUIRES_INVENTORY=0

# --- Backend ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Container resource limits (staging chạy song song với prod) ---
API_MEMORY_LIMIT=768m
DASHBOARD_MEMORY_LIMIT=512m
CADDY_MEMORY_LIMIT=128m
WORKER_MEMORY_LIMIT=256m
POS_RELAY_MEMORY_LIMIT=256m
NOTIFICATION_RELAY_MEMORY_LIMIT=256m
RABBITMQ_MEMORY_LIMIT=512m
KUMA_MEMORY_LIMIT=256m
DOZZLE_MEMORY_LIMIT=128m
CLOUDFLARED_MEMORY_LIMIT=128m

# --- Monitoring (cổng localhost khác prod: prod là 3001 và 8888) ---
KUMA_PORT=3002
DOZZLE_PORT=8889
DOZZLE_AUTH_PROVIDER=none
OPS_DOZZLE_PUBLIC_URL=http://127.0.0.1:8889
OPS_KUMA_PUBLIC_URL=http://127.0.0.1:3002
OPS_SENTRY_PUBLIC_URL=

# --- Optional: Sentry APM (free tier: sentry.io) ---
SENTRY_DSN=
ENABLE_AI_ORCHESTRATOR=false

# --- Optional: Telegram Notifications (from @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CLINIC_ID=a0000000-0000-4000-8000-000000000001

# --- Optional: RabbitMQ (only with --profile workers) ---
RABBITMQ_URL=amqp://clinicai:<url-encoded-rabbitmq-pass>@rabbitmq:5672/clinicai
RABBITMQ_USER=clinicai
RABBITMQ_PASSWORD=<rabbitmq-pass>
RABBITMQ_VHOST=clinicai

# --- Optional: Cloudflare Tunnel ---
TUNNEL_TOKEN=

# Point-of-sale integration (ADR-0010).
# POS_ADAPTER=none

# ── Zalo ZNS — gửi tin cho bệnh nhân ────────────────────────────────────────
ZALO_ZNS_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_NHAC_HEN=
ZALO_ZNS_TEMPLATE_TRA_KET_QUA=

# Số tiến trình Next.js của dashboard.
NEXT_WORKERS=2
DASHBOARD_MEMORY_LIMIT=1g

