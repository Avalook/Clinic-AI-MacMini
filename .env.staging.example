# ClinicAI STAGING env — copy to .env.staging and fill. NEVER commit the filled file.
# Staging runs SIDE-BY-SIDE with prod on the same Mac: different project name +
# different Caddy host ports + a SEPARATE Supabase project.
# Staging Supabase MUST use fake/anonymised data — never a copy of real patient PII.

# --- Environment identity ---
APP_ENV=staging
COMPOSE_PROJECT_NAME=clinicai_staging
IMAGE_TAG=staging

# --- Ingress (Caddy) — different host ports so it does not clash with prod ---
SITE_ADDRESS=:80
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# --- Supabase (STAGING project — fake/anonymised data only) ---
SUPABASE_URL=https://<staging-ref>.supabase.co
SUPABASE_ANON_KEY=<staging-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>
DATABASE_URL=postgresql+asyncpg://postgres.<staging-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
CHECKPOINTER_BACKEND=postgres

# --- Backend ---
ANTHROPIC_API_KEY=sk-ant-...
BACKEND_API_KEY=<long-random-string-staging>

# --- Monitoring (different localhost ports from prod) ---
KUMA_PORT=3002
DOZZLE_PORT=8889
DOZZLE_AUTH_PROVIDER=none

# --- Optional: RabbitMQ (only with --profile workers) ---
RABBITMQ_URL=amqp://clinicai:clinicai_staging_pass@rabbitmq:5672/clinicai
RABBITMQ_USER=clinicai
RABBITMQ_PASSWORD=<rabbitmq-pass>
RABBITMQ_VHOST=clinicai

# --- Optional: Cloudflare Tunnel ---
TUNNEL_TOKEN=
