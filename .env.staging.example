# ClinicAI STAGING env — MẪU. Đừng điền tay: scripts/staging-dung-lan-dau.sh
# sinh .env.staging thật với khoá RIÊNG của staging (xem docs/STAGING.md).
# Không bao giờ commit tệp đã điền.
#
# Staging chạy CHUNG VPS prod (STAGING_KIEU=chung, mặc định) nhưng tách hẳn:
# project compose riêng, bộ Supabase riêng (database riêng), mạng riêng, khoá
# riêng. Dữ liệu = bản sao lưu prod mỗi đêm, DỮ LIỆU KHÁCH ĐÃ CHE.

# --- Danh tính môi trường ---
APP_ENV=staging
COMPOSE_PROJECT_NAME=clinicai_staging
IMAGE_TAG=staging
CLINIC_ENV_FILE=.env.staging
COMPOSE_PROFILES=

# --- Bộ Supabase RIÊNG của staging (scripts/lib/staging-chung.sh chặn tên prod) ---
SUPABASE_PREFIX=clinicai_stg
SUPABASE_NETWORK=clinicai_stg_db_supabase
SUPABASE_GATEWAY_HOST=clinicai_stg_supabase_gateway
AUTH_GUARD_HOST=clinicai_stg_auth_guard
# Chỉ nghe 127.0.0.1 (prod: 54322 / 54321).
SUPABASE_DB_PORT=54332
SUPABASE_API_PORT=54331

# Bí mật — PHẢI KHÁC PROD (script dừng nếu trùng). Sinh bằng sinh-khoa-supabase.py.
SUPABASE_JWT_SECRET=<staging-jwt-secret-khac-prod>
SUPABASE_DB_PASSWORD=<staging-db-password-khac-prod>
SUPABASE_ANON_KEY=<staging-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>
BACKEND_API_KEY=<staging-backend-key-khac-prod>
DATABASE_URL=postgresql+asyncpg://postgres:<staging-db-password>@clinicai_stg_db:5432/postgres
SUPABASE_URL=http://clinicai_stg_supabase_gateway:8000
CHECKPOINTER_BACKEND=postgres

# --- Caddy CỦA STAGING (caddy/Caddyfile.staging) ---
# Kiểu chung: HTTP trần, chỉ 127.0.0.1:8080; Caddy PROD giữ TLS cho tên miền
# staging và chuyển sang đây qua mạng cầu clinicai_staging_edge.
# Kiểu rieng (VPS riêng): SITE_ADDRESS=staging.dr4women.io.vn,
# CADDY_BIND_ADDRESS=0.0.0.0, CADDY_HTTP_PORT=80, CADDY_HTTPS_PORT=443.
SITE_ADDRESS=:80
SITE_URL=https://staging.dr4women.io.vn
CADDY_BIND_ADDRESS=127.0.0.1
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
CADDY_FILE=./caddy/Caddyfile.staging
STAGING_EDGE_NETWORK=clinicai_staging_edge

# --- Địa chỉ trình duyệt gọi Supabase (nung vào bundle lúc dựng ảnh) ---
NEXT_PUBLIC_SUPABASE_URL=https://staging.dr4women.io.vn
NEXT_PUBLIC_SUPABASE_ANON_KEY=<staging-anon-key>

# --- Tệp tải lên của staging: thư mục RIÊNG, không phải kho Viettel CFS ---
# (script sinh đường tuyệt đối ngoài thư mục code, ví dụ ~/clinicai-staging-data)
MEDIA_DIR=./.media
MEDIA_LOCAL_DIR=./.media-vps
OPS_STATUS_DIR=./.ops-status

# --- Nghiệp vụ: script chép CỜ (không chép bí mật) từ .env.prod để cư xử y hệt ---
MO_QUYEN_TAM_THOI=0
KET_QUA_VIDEO_UPLOAD_ENABLED=
CLINICAI_DRUG_PAYMENT_REQUIRES_INVENTORY=0

# --- KHÔNG có khoá gửi tin / tích hợp thật (script dừng nếu có) ---
ANTHROPIC_API_KEY=sk-staging-khong-phai-khoa-that
ENABLE_AI_ORCHESTRATOR=false
POS_ADAPTER=none
NOTIFICATION_RELAY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ZALO_ZNS_ACCESS_TOKEN=
SENTRY_DSN=
TUNNEL_TOKEN=
RABBITMQ_URL=

# --- Trần tài nguyên (docker-compose.staging.yml có sẵn mặc định này) ---
NEXT_WORKERS=1
DASHBOARD_MEMORY_LIMIT=288m
API_MEMORY_LIMIT=384m
SU_KIEN_MEMORY_LIMIT=160m
CADDY_MEMORY_LIMIT=64m
