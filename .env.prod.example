# ClinicAI PROD env — copy to .env.prod and fill. NEVER commit the filled file.
# The deploy script copies the active env to `.env` (used for BOTH compose
# interpolation and container runtime). See scripts/deploy-backend.sh.

# --- Environment identity ---
APP_ENV=production
COMPOSE_PROJECT_NAME=clinicai_prod
IMAGE_TAG=prod
# Must match the file passed to `docker compose --env-file`.
CLINIC_ENV_FILE=.env.prod
# Optional comma-separated services kept current by deploy + self-heal.
# Leave blank until configured; examples: notifications or workers.
COMPOSE_PROFILES=

# --- Ingress (Caddy) ---
# :80 = plain HTTP behind a tunnel (Cloudflare/Tailscale terminates TLS).
# Set to a hostname (e.g. dr4women.example.com) for Caddy-managed HTTPS.
SITE_ADDRESS=:80
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- Supabase (PROD project) ---
SUPABASE_URL=https://<prod-ref>.supabase.co
SUPABASE_ANON_KEY=<prod-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<prod-service-role-key>
DATABASE_URL=postgresql+asyncpg://postgres.<prod-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
CHECKPOINTER_BACKEND=postgres

# --- Backend ---
ANTHROPIC_API_KEY=sk-ant-...
BACKEND_API_KEY=<long-random-string>

# --- Monitoring (bound to 127.0.0.1 → reach via Tailscale only) ---
KUMA_PORT=3001
DOZZLE_PORT=8888
DOZZLE_AUTH_PROVIDER=none
OPS_STATUS_DIR=/Users/quangdang/.clinicai/ops
OPS_DOZZLE_PUBLIC_URL=http://127.0.0.1:8888
OPS_KUMA_PUBLIC_URL=http://127.0.0.1:3001
OPS_SENTRY_PUBLIC_URL=

# --- Optional: Sentry APM (free tier: sentry.io) ---
SENTRY_DSN=

# --- Optional: Telegram Notifications (from @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: RabbitMQ (only with --profile workers) ---
RABBITMQ_URL=amqp://clinicai:clinicai_prod_pass@rabbitmq:5672/clinicai
RABBITMQ_USER=clinicai
RABBITMQ_PASSWORD=<rabbitmq-pass>
RABBITMQ_VHOST=clinicai

# --- Optional: Cloudflare Tunnel (only with --profile cloudflare) ---
TUNNEL_TOKEN=
