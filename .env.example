# ClinicAI Environment Variables
# Copy file này thành .env và điền giá trị thật (KHÔNG commit .env)

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Service-role key — REQUIRED for the dashboard /settings/new-user
# admin-create-user flow (F3). Bypasses RLS — NEVER ship to the browser.
# Used server-side by app/api/admin/users/route.ts only.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
# Separate DISPOSABLE database for DB tests. DB-touching tests (pytest -m db)
# ONLY connect here — never to prod DATABASE_URL. Leave unset → DB tests skip.
DATABASE_URL_TEST=postgresql+asyncpg://user:pass@host:5432/dbname_test

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# === RabbitMQ (T-P5-02; required only with Compose profile `workers`) ===
# Generate a unique local value; there is intentionally no shared default.
RABBITMQ_URL=amqp://clinicai:<url-encoded-rabbitmq-pass>@localhost:5672/clinicai
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=clinicai
RABBITMQ_PASSWORD=<rabbitmq-pass>
RABBITMQ_VHOST=clinicai
RABBITMQ_EXCHANGE=events.topic
RABBITMQ_DLX=events.dlx

# App
APP_ENV=development
LOG_LEVEL=DEBUG

# LangGraph checkpointer — `postgres` để orchestrator state sống qua restart
# (mất điện/reboot). Prod trên Mac mini nên đặt postgres; dev có thể để `memory`.
# Mặc định trong docker-compose.prod.yml = postgres. Dùng chung DATABASE_URL.
CHECKPOINTER_BACKEND=postgres

# Base URL FastAPI để DASHBOARD (Vercel) gọi tới — set BÊN VERCEL, không phải ở đây.
# Mac mini (server) KHÔNG cần biến này. Ví dụ giá trị trên Vercel:
#   Tailscale Funnel:  https://<tên-máy>.<tailnet>.ts.net   (KHÔNG /api/v1, KHÔNG / cuối)
#   Cloudflare Tunnel: https://api.<domain>
# CLINIC_API_URL=

# Cờ cutover Phase 4 / W5 (ADR-0012) — bật từng route một để dời logic từ Next
# route handler sang FastAPI. Tắt (bỏ trống) = giữ đường cũ đọc/ghi thẳng Supabase.
# Chỉ bật khi CLINIC_API_URL trỏ được tới api, và mọi nhân viên đã có login riêng.

# (Tùy chọn) UUID cơ sở mặc định cho scheduling graph.
# DEFAULT_LOCATION_ID=
# AI orchestrator còn là bề mặt thử nghiệm; production/staging mặc định tắt.
ENABLE_AI_ORCHESTRATOR=false

# (Tùy chọn, CHỈ khi dùng Cloudflare Tunnel qua `--profile cloudflare`)
# Token từ Cloudflare Zero Trust → Networks → Tunnels. Base MVP dùng Tailscale → để trống.
# TUNNEL_TOKEN=

# Backend API key — gates every FastAPI route except /health, /health/db, /docs.
# Production/staging MUST set this; missing key fails closed with HTTP 503.
# Only explicit APP_ENV=dev/test may run without it.
BACKEND_API_KEY=<generate-a-long-random-string>

# Notion (Phase 1 sync source)
NOTION_API_KEY=<notion-integration-token>
# Root page of the cloned PK Notion workspace (no dashes is fine).
LINK_NOTION_PAGE_ID=<notion-root-page-id>

# Point-of-sale integration (ADR-0010). ClinicAI owns payment + inventory;
# a POS is something we push TO, never read truth from. `none` (default) keeps
# the door open without depending on anyone walking through it. Per-clinic
# credentials live in clinic.settings->'pos', not here.
# POS_ADAPTER=none
