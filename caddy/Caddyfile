# ClinicAI reverse proxy. The ONLY public-facing service.
#
# SITE_ADDRESS controls TLS behaviour:
#   :80                    → plain HTTP; TLS terminated UPSTREAM by the tunnel
#                            (Cloudflare Tunnel / Tailscale Funnel). DEFAULT.
#   dr4women.example.com   → Caddy provisions Let's Encrypt certs itself
#                            (direct-domain mode; open CADDY_HTTPS_PORT=443).
{
	admin off
	# Log LỖI của Caddy (dial dashboard hỏng, upstream timeout…) cũng in
	# nguyên `request>uri` — đi qua bộ ghi mặc định này, không qua khối `log`
	# của site bên dưới. Cắt `?…` y như access log (xem giải thích ở đó).
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ?…
				request>headers>Referer regexp \?.*$ ?…
			}
		}
	}
}

# ĐƯỜNG SỐNG-CHẾT CHO HEALTHCHECK, CHỈ NGHE TRONG MÁY.
#
# VÌ SAO TÁCH RA (16/09/2026). Healthcheck của compose gõ
# `http://localhost:80/health`. Ở chế độ tunnel (`SITE_ADDRESS=:80`) nó chạy
# đúng. Nhưng ngày bật tên miền thật, Caddy tự chuyển mọi thứ ở cổng 80 sang
# HTTPS — wget đi theo, bắt tay TLS với tên `localhost` mà máy chủ không có
# chứng chỉ cho tên ấy, và nhận `SSL alert number 80`.
#
# Kết quả đo được ngay hôm bật HTTPS: container Caddy đỏ **377 lần liên tiếp**
# trong khi trang web phục vụ 200 hoàn toàn bình thường. Đó là kiểu hỏng tệ
# nhất của giám sát — một đèn đỏ GIẢ. Người trực nhìn nó vài ngày là quen bỏ
# qua màu đỏ, và lần đỏ thật cũng bị bỏ qua nốt.
#
# Khối này khai `http://` tường minh nên Caddy KHÔNG tự nâng cấp nó, và nó chỉ
# khớp khi Host là localhost/127.0.0.1 — tức chỉ chính máy này gọi được. Mọi
# request từ ngoài mang Host là tên miền, nên vẫn rơi vào khối bên dưới.
http://localhost, http://127.0.0.1 {
	handle /health {
		log_skip
		respond "ok" 200
	}
	# Không mở gì khác qua cửa này.
	respond 404
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# --- Access log ------------------------------------------------------------
	#
	# VÌ SAO CÓ, 21/08/2026: người dùng báo trang thi thoảng treo ở khung xương,
	# mà phía máy chủ KHÔNG có một dòng nào về request của họ — Caddy mặc định
	# không ghi access log, `docker logs` chỉ có log lỗi của reverse_proxy. Mọi
	# phép tìm "request chậm hơn 2s" đều rỗng một cách VÔ NGHĨA: không phân biệt
	# được "không có gì chậm" với "không có gì được ghi".
	#
	# Access log là mảnh phân xử: lần treo sau, request KHÔNG xuất hiện ở đây
	# ⇒ nó chưa tới máy chủ (lỗi đường mạng phòng khám ↔ VPS); xuất hiện mà
	# `duration` lớn ⇒ lỗi phía máy chủ.
	#
	# JSON mặc định đã có đủ `duration`, `status`, `request>uri`, và giữ cả
	# `client_ip` — mạng nội bộ phòng khám, cần IP để lần sự cố mạng. Ra stdout
	# để Docker quản dung lượng (json-file, max-size 10m × 5 file — xem anchor
	# `clinic-service-defaults` trong docker-compose.yml); log lỗi runtime của
	# Caddy vẫn ra stderr, hai dòng không trộn.
	log {
		output stdout
		# Cắt NGUYÊN chuỗi truy vấn (`?…`) khỏi đường dẫn và Referer (27/09/2026):
		# ô tìm khách gửi SĐT / tên qua `?phone=` `?q=`… — log không được giữ
		# dữ liệu bệnh nhân (Nghị định 13/2023). Cắt cả chuỗi chứ không liệt kê
		# tên tham số: thêm một ô tìm mới là quên thêm vào danh sách.
		# Cookie / Authorization Caddy đã tự che sẵn.
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ?…
				request>headers>Referer regexp \?.*$ ?…
			}
		}
	}

	# --- Security headers (OWASP best-practices) ---
	header {
		# HSTS: force HTTPS for 1 year (browsers remember).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Prevent MIME-sniffing attacks.
		X-Content-Type-Options "nosniff"
		# Block embedding in iframes (clickjacking).
		X-Frame-Options "DENY"
		# Control referrer leakage.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Deny access to sensitive device APIs.
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Don't leak the server tech stack.
		-Server
	}

	# Liveness for the compose healthcheck (works in :80 tunnel mode).
	#
	# `log_skip`: healthcheck gõ /health mỗi 20 giây — hơn 4.000 dòng/ngày toàn
	# một câu trả lời do chính Caddy tự nói, không cho biết gì về mạng hay ứng
	# dụng, chỉ vùi các request thật của người dùng xuống dưới.
	handle /health {
		log_skip
		respond "ok" 200
	}

	# --- Supabase tự dựng: ba đường mà TRÌNH DUYỆT gọi thẳng ---------------
	#
	# Khi database chạy ngay trên máy này (không dùng Supabase cloud), trình
	# duyệt vẫn cần tới `/auth/v1` để đăng nhập, `/rest/v1` để đọc bảng và
	# `/realtime/v1` cho websocket. Ba đường ấy KHÔNG đi qua Next.js — thư viện
	# supabase-js gọi thẳng từ trình duyệt.
	#
	# Nên Caddy phải chuyển tiếp chúng sang bộ gateway của stack `clinicai_db`.
	# Giữ nguyên tiền tố (`handle` chứ không `handle_path`) vì gateway bên kia
	# mới là chỗ cắt.
	#
	# TÊN GATEWAY THEO BIẾN, KHÔNG GHI CỨNG.
	#
	# Ghi cứng `clinicai_supabase_gateway` nghĩa là bản staging sẽ gọi thẳng
	# vào database của phòng khám ĐANG CHẠY THẬT — đúng thứ việc tách hai môi
	# trường sinh ra để chặn. Lần dựng staging đầu tiên nó lỗi 502 chứ không rò
	# sang prod, chỉ vì staging không được nối vào mạng của prod; đó là may,
	# không phải thiết kế.
	#
	# Caddy tới được nhờ được nối vào mạng của stack Supabase tương ứng — xem
	# `networks` của dịch vụ caddy trong compose.
	# ĐƯỜNG ĐĂNG NHẬP ĐI VÒNG QUA BỘ CHẶN DÒ MẬT KHẨU.
	#
	# Đo ngày 12/08/2026: 10 lần đăng nhập sai liên tiếp vào PROD đều lọt, không
	# lần nào bị chặn. GoTrue v2.177.0 không có giới hạn nào cho grant_type=
	# password (đã dò chuỗi trong binary), Caddy bản gốc không có module giới hạn,
	# và cổng Supabase cũng là Caddy. Nên phải có một nginx nhỏ đứng riêng.
	#
	# CHỈ `/auth/v1/token` — không phải cả `/auth/v1/*`. Đổi mật khẩu, đăng xuất
	# đều nằm trong `/auth/v1` và không phải chỗ để dò; kéo hết qua bộ chặn là mở
	# rộng vùng có thể hỏng mà không đổi lại được gì.
	#
	# Ngưỡng đặt rộng (20 lần/phút, dồn 10) vì cả phòng khám dùng chung một địa
	# chỉ IP — xem docker/auth-guard.conf.
	@dangnhap path /auth/v1/token*
	handle @dangnhap {
		reverse_proxy {$AUTH_GUARD_HOST:clinicai_auth_guard}:80
	}

	@supabase path /auth/v1/* /rest/v1/* /realtime/v1/*
	handle @supabase {
		reverse_proxy {$SUPABASE_GATEWAY_HOST:clinicai_supabase_gateway}:8000
	}

	# Everything else → Next.js dashboard. The dashboard (UI) calls the FastAPI
	# backend internally at http://api:8000; the API is never exposed publicly.
	handle {
		reverse_proxy dashboard:3000
	}
}

# SITE PHỤ (01/10/2026): mọi `*.caddy` trong caddy/them/ — hiện chỉ có site
# staging do scripts/staging-dung-lan-dau.sh viết ra (không vào git). Thư mục
# rỗng thì mẫu glob không khớp gì và Caddy chạy y như trước. Xem
# caddy/them/README.md.
import /etc/caddy/them/*.caddy
