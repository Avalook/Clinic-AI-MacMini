# Caddy CỦA STAGING (01/10/2026) — xem docs/STAGING.md.
#
# Hai kiểu chạy, cùng một file:
#   chung  (mặc định) staging nằm chung VPS prod. SITE_ADDRESS=:80, HTTP trần.
#          Caddy PROD giữ TLS cho tên miền staging (caddy/them/staging.caddy)
#          rồi chuyển mọi request sang đây qua mạng cầu `clinicai_staging_edge`.
#   rieng  staging có VPS riêng. SITE_ADDRESS=staging.dr4women.io.vn, Caddy này
#          tự xin chứng chỉ Let's Encrypt và nghe 80/443.
#
# Khác Caddyfile của prod ở ba chỗ:
#   1. Tên gateway/guard MẶC ĐỊNH là của staging (clinicai_stg_*). Thiếu biến
#      thì không bao giờ rơi về tên của prod.
#   2. X-Robots-Tag noindex + /robots.txt chặn hết — bản thử không lên Google.
#   3. Không ổ khoá HTTP (basic auth): ai có tài khoản prod là vào thử được.
#      Dữ liệu khách đã che; tài khoản/mật khẩu y hệt prod (Tuyền chốt 01/10).
{
	admin off
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ?…
				request>headers>Referer regexp \?.*$ ?…
			}
		}
	}
}

# Healthcheck của compose gõ http://localhost:80/health — giữ được cả khi
# SITE_ADDRESS là tên miền thật (kiểu rieng). Xem giải thích ở caddy/Caddyfile.
http://localhost, http://127.0.0.1 {
	handle /health {
		log_skip
		respond "ok" 200
	}
	respond 404
}

{$SITE_ADDRESS} {
	encode zstd gzip

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ?…
				request>headers>Referer regexp \?.*$ ?…
			}
		}
	}

	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}

	handle /health {
		log_skip
		respond "ok" 200
	}

	@dangnhap path /auth/v1/token*
	handle @dangnhap {
		reverse_proxy {$AUTH_GUARD_HOST:clinicai_stg_auth_guard}:80
	}

	@supabase path /auth/v1/* /rest/v1/* /realtime/v1/*
	handle @supabase {
		reverse_proxy {$SUPABASE_GATEWAY_HOST:clinicai_stg_supabase_gateway}:8000
	}

	handle {
		reverse_proxy dashboard:3000
	}
}
