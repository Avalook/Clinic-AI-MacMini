[Unit]
Description=ClinicAI — pgBackRest bản ĐẦY ĐỦ (sao lưu nối tiếp)
Documentation=file:///home/clinicai/clinicai/docs/KE-HOACH-SAO-LUU-NOI-TIEP.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=clinicai
WorkingDirectory=/home/clinicai/clinicai
Environment=CLINIC_DB_CONTAINER=clinicai_db
ExecStart=/home/clinicai/clinicai/scripts/sao-luu-noi-tiep.sh full
StandardOutput=journal
StandardError=journal
