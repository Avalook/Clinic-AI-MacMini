<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchDaemon: Docker cleanup — runs weekly on Sunday at 3:00 AM.
  Removes dangling images, stopped containers, build cache > 7 days.

  Install:
    sudo cp scripts/launchdaemons/com.dr4women.docker-cleanup.plist /Library/LaunchDaemons/
    sudo launchctl load /Library/LaunchDaemons/com.dr4women.docker-cleanup.plist

  Unload:
    sudo launchctl unload /Library/LaunchDaemons/com.dr4women.docker-cleanup.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dr4women.docker-cleanup</string>

  <key>UserName</key>
  <string>quangdang</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/quangdang/Projects/Dr4Women-MacMini/scripts/docker-cleanup.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/quangdang</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Run every Sunday at 03:00 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/quangdang/Library/Logs/docker-cleanup.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/quangdang/Library/Logs/docker-cleanup.err.log</string>
</dict>
</plist>
