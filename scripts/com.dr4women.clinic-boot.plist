<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Thay cho com.dr4women.clinic-backend.plist (trỏ vào ~/clinic-server, dựng
  stack cũ và bật Tailscale Funnel). Xem lý do đầy đủ ở scripts/clinic-boot.sh
  và docs/len-vps.md.

  Cài (cần mật khẩu máy):
    sudo launchctl bootout system /Library/LaunchDaemons/com.dr4women.clinic-backend.plist
    sudo mv /Library/LaunchDaemons/com.dr4women.clinic-backend.plist ~/Desktop/clinic-backend.plist.tat
    sudo cp scripts/com.dr4women.clinic-boot.plist /Library/LaunchDaemons/
    sudo chown root:wheel /Library/LaunchDaemons/com.dr4women.clinic-boot.plist
    sudo launchctl bootstrap system /Library/LaunchDaemons/com.dr4women.clinic-boot.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dr4women.clinic-boot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/quangdang/Projects/Dr4Women-MacMini/scripts/clinic-boot.sh</string>
    <string>/Users/quangdang/Projects/Dr4Women-MacMini</string>
    <string>prod</string>
  </array>

  <!-- Chạy lúc máy khởi động (không cần đăng nhập GUI) + mỗi 5 phút để tự
       chữa sau khi Colima chết. `up -d` không đụng gì khi mọi thứ đã đúng. -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>

  <!-- Chạy dưới tài khoản người dùng: Colima và Docker context thuộc về nó,
       chạy bằng root sẽ tìm không thấy máy ảo Colima nào. -->
  <key>UserName</key>
  <string>quangdang</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/quangdang</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/quangdang/Library/Logs/clinic-boot.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/quangdang/Library/Logs/clinic-boot.err.log</string>
</dict>
</plist>
