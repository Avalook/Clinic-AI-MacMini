# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored to the repo root on purpose. Unanchored, `lib/` matches a directory
# named lib at ANY depth, which silently swallowed scripts/lib/ — CI then failed
# for three weeks on a helper that existed on every developer machine and in no
# checkout. These two are setuptools build output at the root, nothing else.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.next/
out/

# Env / secrets
.env
.env.*
!.env.example
!.env.prod.example
!.env.staging.example
.active-state-*
.release-env-*/
.release-source-*/
.ops-status/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code local artifacts (worktrees = nested git clones, never commit)
.claude/

# Headroom local agent memory. Some legacy files are still tracked; remove them
# from the Git index in a coordinated clean change without deleting local state.
.headroom/

# Logs
*.log
logs/

# RabbitMQ runtime data
docker/rabbitmq/data/
docker/rabbitmq/log/
docker/rabbitmq/mnesia/

# Data audit / patient data — NEVER commit
# Anchor to repo root so scripts/data_audit/ (audit tooling) stays tracked.
/data_audit/
/data_raw/
*.csv
*.xlsx
*.xls
# Allow seed CSVs that ship with the repo (clinic master data)
!src/migrations/seed/**/*.csv
!src/migrations/seed/**/*.xlsx

# Next.js dashboard (P7a)
src/dashboard/node_modules/
src/dashboard/.next/
src/dashboard/.env.local
src/dashboard/.env.*.local
# The global ``lib/`` (Python build artifact) above accidentally hides the
# dashboard's source ``lib/`` folder — un-ignore it so e.g. supabase-server.ts
# and current-staff.ts can be tracked.
!src/dashboard/lib/
!src/dashboard/lib/**

# Seed ETL artifacts (Task A — contains real patient data, never commit)
scripts/seed/seed_sample.json
scripts/seed/*.csv

# T-TRANSFORM-01 staged outputs (real patient data — never commit)
scripts/data_migration/output/

# DB reset backups (may contain patient PII — never commit)
scripts/maintenance/backups/

# Supabase CLI local link/cache metadata
/supabase/.temp/

# Supabase CLI local state
/supabase/.branches/
.dev-logs/

# Trạng thái của công cụ dev (headroom/serena/codex). Chúng đổi mỗi phiên làm
# việc và không phải mã nguồn — để tracked thì worktree lúc nào cũng "bẩn" và
# scripts/deploy-backend.sh từ chối deploy, đúng như đã xảy ra.
.headroom/
.serena/
.codex/
.feedback/

# --- Bí mật vận hành để LOCAL, không lên GitHub -----------------------------
# Repo này PUBLIC (xem .github/workflows/cd.yml: "this repository is public").
#
# apply-pending-migrations.sh hiện chứa connection string prod kèm mật khẩu ở
# dạng thô. Quang giữ nguyên như vậy để agent thao tác được — quyết định đó ổn
# khi file KHÔNG BAO GIỜ rời khỏi máy. Ignore ở đây giữ đúng hai điều cùng lúc:
# script vẫn dùng bình thường, và `git add -A` không đẩy mật khẩu prod lên một
# repo mà ai cũng fork được.
scripts/apply-pending-migrations.sh

# Email công việc của từng nhân viên (provision-staff-logins.sh). Dữ liệu cá
# nhân, và cũng là danh sách mục tiêu phishing hoàn chỉnh cho một phòng khám.
scripts/staff-emails.csv
